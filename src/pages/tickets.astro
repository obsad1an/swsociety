  <div class="page">
    <section class="content-page" style="text-align: center;">
      <p class="content-label">
        <span class="lang-de">Deinen Platz reservieren</span>
        <span class="lang-en">Reserve your spot</span>
      </p>
      <h1>Tickets</h1>
      <p class="content-subtitle">
        <span class="lang-de">Demnächst verfügbar.</span>
        <span class="lang-en">Coming soon.</span>
      </p>
    </section>
  </div>
</BaseLayout>
