---
import "../styles/global.css";
const { title } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ?? "Safeword Society"}</title>

    <!-- Both theme and language set before paint — zero flicker -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem("swsociety-theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
        var l = localStorage.getItem("swsociety-lang");
        if (l) document.documentElement.setAttribute("data-lang", l);
      })();
    </script>
  </head>

  <body>
    <div class="bg-layer"></div>

    <div id="container">
      <header>
        <div class="top-nav">

          <!-- Logo -->
          <a href="/" class="nav-logo" aria-label="Safeword Society Home">
            <svg
              class="nav-logo-svg"
              viewBox="0 0 270 62"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <text x="135" y="24" text-anchor="middle"
                font-family="'Bodoni Moda', 'Times New Roman', serif"
                font-size="20" font-weight="400" letter-spacing="7" fill="currentColor"
              >SAFEWORD</text>
              <line x1="28" y1="32" x2="242" y2="32"
                stroke="currentColor" stroke-width="0.6" opacity="0.35"/>
              <text x="135" y="56" text-anchor="middle"
                font-family="'Bodoni Moda', 'Times New Roman', serif"
                font-size="26" font-weight="500" letter-spacing="9" fill="currentColor"
              >SOCIETY</text>
            </svg>
          </a>

          <!-- Navigation -->
          <nav class="nav-links">
            <a href="/aboutus">
              <span class="lang-de">Über uns</span>
              <span class="lang-en">About Us</span>
            </a>
            <a href="/aboutevent">
              <span class="lang-de">Über das Event</span>
              <span class="lang-en">About the Event</span>
            </a>
            <a href="/tickets">Tickets</a>
          </nav>

          <!-- Controls: Language + Mood -->
          <div class="nav-controls">
            <button class="lang-toggle" aria-label="Toggle language" onclick="toggleLang()">
              <span class="lang-toggle-de">DE</span>
              <span class="lang-toggle-sep"> · </span>
              <span class="lang-toggle-en">EN</span>
            </button>

            <button class="mood-toggle" aria-label="Toggle light/dark mood" onclick="toggleTheme()">
              <span class="toggle-pill" aria-hidden="true"></span>
              <span class="toggle-label">Mood</span>
            </button>
          </div>
        </div>
      </header>

      <div class="site-content">
        <slot />
      </div>

      <footer class="site-footer">
        <div class="footer-inner">
          <span>© {new Date().getFullYear()} Safeword Society</span>
          <div class="footer-right">
            <a href="/impressum">Impressum</a>
            <a href="mailto:hello@safewordsociety.me" aria-label="Email" class="social-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.5"/>
                <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="https://instagram.com/safewordsociety" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
              </svg>
            </a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      // Theme
      window.setTheme = function (theme: string) {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("swsociety-theme", theme);
      };
      window.toggleTheme = function () {
        const current = document.documentElement.getAttribute("data-theme") || "dark";
        window.setTheme(current === "dark" ? "light" : "dark");
      };

      // Language
      window.setLang = function (lang: string) {
        document.documentElement.setAttribute("data-lang", lang);
        document.documentElement.setAttribute("lang", lang);
        localStorage.setItem("swsociety-lang", lang);
      };
      window.toggleLang = function () {
        const current = document.documentElement.getAttribute("data-lang") || "de";
        window.setLang(current === "de" ? "en" : "de");
      };

      // Active nav link
      document.querySelectorAll(".nav-links a").forEach((link) => {
        if ((link as HTMLAnchorElement).pathname === window.location.pathname) {
          link.classList.add("active");
        }
      });
    </script>
  </body>
</html>
